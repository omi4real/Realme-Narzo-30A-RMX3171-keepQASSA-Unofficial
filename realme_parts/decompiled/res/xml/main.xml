<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/smart_charging_main_title" android:key="charging">
        <SwitchPreference android:icon="@drawable/ic_charging_main" android:title="@string/smart_charging_title" android:key="smart_charging" android:summary="@string/smart_charging_summary" />
        <com.realmeparts.SecureSettingListPreference android:icon="@drawable/ic_charging_speed" android:entries="@array/charging_speed_entries" android:title="Charging Speed" android:key="charging_speed" android:summary="%s" android:defaultValue="0" android:dialogTitle="Select Charging Speed" android:entryValues="@array/charging_speed_values" />
        <com.realmeparts.SeekBarPreference android:layout_gravity="center_vertical" android:layout="@layout/preference_slider" android:layout_width="fill_parent" android:max="100" android:title="Select charging limit" android:key="seek_bar" android:defaultValue="95" android:min="80" />
        <SwitchPreference android:icon="@drawable/ic_info_outline_24dp" android:title="@string/reset_stats_title" android:key="reset_stats" android:summary="@string/reset_stats_summary" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/display_title" android:key="graphics">
        <com.realmeparts.SecureSettingListPreference android:icon="@drawable/ic_cabc" android:entries="@array/cabc_profiles" android:title="@string/cabc_title" android:key="cabc" android:defaultValue="0" android:dialogTitle="@string/cabc_dialogTitle" android:entryValues="@array/cabc_values" />
        <SwitchPreference android:icon="@drawable/dc_mode_icon" android:title="@string/dc_mode_title" android:key="dc" android:summary="@string/dc_mode_summary" />
        <SwitchPreference android:icon="@drawable/ic_hbm" android:title="@string/hbm_mode_title" android:key="hbm" android:summary="@string/hbm_mode_summary" />
        <SwitchPreference android:icon="@drawable/srgb_mode_icon" android:title="@string/srgb_mode_title" android:key="srgb" android:summary="@string/srgb_mode_summary" />
        <SwitchPreference android:icon="@drawable/game_mode_icon" android:title="@string/game_mode_title" android:key="game" android:summary="@string/game_mode_summary" />
        <SwitchPreference android:icon="@drawable/ic_info_outline_24dp" android:title="@string/dnd_title" android:key="dnd" android:summary="@string/dnd_summary" />
        <SwitchPreference android:icon="@drawable/ic_dt2w" android:title="@string/dt2w_title" android:key="dt2w" android:summary="@string/dt2w_summary" />
        <Preference android:title="@string/ambient_display_gestures_title" android:key="doze" android:summary="@string/ambient_display_gestures_summary">
            <intent android:targetPackage="com.realmeparts" android:action="android.intent.action.MAIN" android:targetClass="com.realmeparts.doze.DozeSettingsActivity" />
        </Preference>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/refresh_title" android:key="refresh_rate">
        <com.realmeparts.RadioButtonPreference android:icon="@drawable/refresh_rate_60_icon" android:checked="false" android:title="@string/refresh_rate_60_title" android:key="refresh_rate_60" android:summary="@string/refresh_rate_60_summary" />
        <com.realmeparts.RadioButtonPreference android:icon="@drawable/refresh_rate_90_icon" android:enabled="true" android:checked="true" android:title="@string/refresh_rate_90_title" android:key="refresh_rate_90" android:summary="@string/refresh_rate_90_summary" />
        <SwitchPreference android:icon="@drawable/refresh_rate_90forced_icon" android:title="@string/refresh_rate_90Forced_title" android:key="refresh_rate_90Forced" android:summary="@string/refresh_rate_90Forced_summary" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/misc_title" android:key="misc">
        <SwitchPreference android:icon="@drawable/usb_otg_icon" android:title="@string/otg_mode_title" android:key="otg" android:summary="@string/otg_mode_summary" />
        <SwitchPreference android:icon="@drawable/fps_info_icon" android:persistent="true" android:title="@string/fps_info_title" android:key="fps_info" android:summary="@string/fps_info_summary" />
    </PreferenceCategory>
</PreferenceScreen>